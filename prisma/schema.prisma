// Prisma schema for Neon PostgreSQL tailored to Webad new schema
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GlobalSetting {
  id               String   @id @default("default")
  siteName         String   @default("PT Adre Gemilang Jaya")
  logoUrl          String?  @default("/images/logo-adre.png")
  tagline          String   @default("Organisasi Esports Jakarta Indonesia")
  businessEmail    String   @default("contact@adregemilang.co.id")
  partnershipEmail String   @default("partnership@adregemilang.co.id")
  addressShort     String   @default("SCBD, Jakarta Selatan, DKI Jakarta, Indonesia")
  socials          Json?
  updatedAt        DateTime @updatedAt
}

model Division {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  shortCode         String         @default("PUBGM")
  gameTitle         String         @default("PUBG Mobile")
  bannerImageUrl    String?
  activeRosterCount Int            @default(0)
  tagline           String         @default("")
  description       String         @default("")
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  roster       RosterMember[]
  achievements Achievement[]
  matches      Match[]
}

model RosterMember {
  id           String    @id @default(cuid())
  divisionId   String
  division     Division  @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  ign          String
  fullName     String
  role         String    // "IGL" | "RUSHER" | "SUPPORT" | "SCOUT" | "MANAGER" | "COACH" | "ANALYST"
  roleType     String    @default("PLAYER") // "PLAYER" | "STAFF"
  countryCode  String    @default("ID")
  photoUrl     String?
  joinDate     String?
  displayOrder Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Achievement {
  id         String   @id @default(cuid())
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  title      String
  placement  String
  year       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Match {
  id              String             @id @default(cuid())
  divisionId      String
  division        Division           @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  tournamentName  String
  stage           String
  scheduledAt     DateTime
  status          String             @default("UPCOMING") // "UPCOMING" | "LIVE" | "COMPLETED"
  formatType      String             @default("BATTLE_ROYALE") // "BATTLE_ROYALE" | "TACTICAL_5V5"
  streamUrl       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  resultBattleRoyale BattleRoyaleResult?
}

model BattleRoyaleResult {
  id             String   @id @default(cuid())
  matchId        String   @unique
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  placement      Int
  placementLabel String   // e.g. "#1 WWCD"
  totalPoints    Int
  wwcdCount      Int?     @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ArticleCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  articles Article[]
}

model Article {
  id                 String          @id @default(cuid())
  title              String
  slug               String          @unique
  excerpt            String
  contentHtml        String
  coverImageUrl      String?
  coverImageAlt      String          @default("")
  isFeatured         Boolean         @default(false)
  publishedAt        DateTime        @default(now())
  readingTimeMinutes Int             @default(3)
  categoryId         String
  category           ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorName         String          @default("Tim Media PT Adre Gemilang Jaya")
  authorAvatarUrl    String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Partner {
  id           String   @id @default(cuid())
  name         String
  tier         String   @default("OFFICIAL") // "PRINCIPAL" | "OFFICIAL"
  logoUrl      String?
  websiteUrl   String
  description  String?
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HeroStat {
  id           String   @id @default(cuid())
  label        String
  value        String
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CompanyProfile {
  id               String   @id @default("default")
  companyName      String   @default("PT Adre Gemilang Jaya")
  aboutHtml        String   @default("")
  companyImageUrl  String?
  vision           String   @default("")
  missions         Json?
  coreValues       Json?
  milestones       Json?
  businessEmail    String   @default("business@adregemilangjaya.com")
  partnershipEmail String   @default("partnership@adregemilangjaya.com")
  officeAddress    String   @default("Jakarta, Indonesia")
  mapEmbedUrl      String?
  socials          Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

